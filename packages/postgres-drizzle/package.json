{
	"name": "@mdsrs/postgres-drizzle",
	"version": "0.0.0",
	"description": "Postgres and Drizzle SrsStore backend for mdsrs.",
	"homepage": "https://cgutiguti.github.io/mdsrs/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cgutiguti/mdsrs.git",
		"directory": "packages/postgres-drizzle"
	},
	"bugs": {
		"url": "https://github.com/cgutiguti/mdsrs/issues"
	},
	"license": "MIT",
	"keywords": ["spaced-repetition", "srs", "markdown", "postgres", "drizzle"],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"default": "./dist/schema.js"
		}
	},
	"files": ["dist", "migrations"],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "vitest run",
		"test:integration": "vitest run src/postgres.integration.test.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@mdsrs/core": "workspace:*",
		"@mdsrs/store": "workspace:*",
		"drizzle-orm": "^0.45.2"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/pg": "^8.20.0",
		"pg": "^8.21.0",
		"typescript": "^6.0.3",
		"vitest": "^4.0.0"
	}
}
