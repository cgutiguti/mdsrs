{
	"name": "@mdsrs/file-store",
	"version": "0.0.0",
	"description": "Local JSON-file SrsStore backend for mdsrs.",
	"homepage": "https://cgutiguti.github.io/mdsrs/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cgutiguti/mdsrs.git",
		"directory": "packages/file-store"
	},
	"bugs": {
		"url": "https://github.com/cgutiguti/mdsrs/issues"
	},
	"license": "MIT",
	"keywords": ["spaced-repetition", "srs", "markdown", "flashcards", "local-first"],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "vitest run src/*.test.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@mdsrs/core": "workspace:*",
		"@mdsrs/store": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"typescript": "^6.0.3",
		"vitest": "^4.0.0"
	}
}
