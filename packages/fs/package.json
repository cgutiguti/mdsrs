{
	"name": "@mdsrs/fs",
	"version": "0.0.0",
	"description": "Filesystem loader for Markdown-native mdsrs card collections.",
	"homepage": "https://cgutiguti.github.io/mdsrs/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cgutiguti/mdsrs.git",
		"directory": "packages/fs"
	},
	"bugs": {
		"url": "https://github.com/cgutiguti/mdsrs/issues"
	},
	"license": "MIT",
	"keywords": ["spaced-repetition", "srs", "markdown", "flashcards", "filesystem"],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@mdsrs/core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"typescript": "^6.0.3",
		"vitest": "^4.0.0"
	}
}
