{
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"exactOptionalPropertyTypes": true,
		"isolatedModules": true,
		"lib": ["ES2024"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmitOnError": true,
		"noUncheckedIndexedAccess": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2024"
	}
}
